table 'Calc. Group - Time Intelligence for Calenday (Weekly)'
	lineageTag: 001419f5-5059-4c68-8bb7-2dd997224dd6

	calculationGroup
		precedence: 4

		calculationItem WTD = ```
				IF ( 
				    [ShowValueForDates],
				    VAR LastDayOfWeekAvailable =  MAX ( 'bc_date'[WeekDayNumber] )
				    VAR LastFiscalYearWeekAvailable = MAX ( 'bc_date'[FW YearWeekNumber] )
				    VAR Result =
				        CALCULATE (
				            SELECTEDMEASURE(),
				            ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				            'bc_date'[WeekDayNumber] <= LastDayOfWeekAvailable,
				            'bc_date'[FW YearWeekNumber] = LastFiscalYearWeekAvailable
				        )
				    RETURN
				        Result
				)
				```

		calculationItem PP = ```
				VAR _PW = IF (
				    [ShowValueForDates],
				    SUMX ( 
				        VALUES ( 'bc_date'[FW YearWeekNumber] ),
				        VAR CurrentFiscalYearWeekNumber = 'bc_date'[FW YearWeekNumber] 
				        VAR DaysSelected = 
				            CALCULATETABLE (
				                VALUES ( 'bc_date'[WeekDayNumber] ),
				                REMOVEFILTERS (
				                    'bc_date'[IsWorkingDay],
				                    'bc_date'[Week Day],
				                    'bc_date'[WeekDayNumber]
				                ),
				                'bc_date'[DatesWithTransactions] = TRUE
				            )
				        RETURN 
				            CALCULATE (
				                SELECTEDMEASURE(),
				                'bc_date'[FW YearWeekNumber] = CurrentFiscalYearWeekNumber - 1,
				                KEEPFILTERS ( DaysSelected ),
				                ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] )
				            )
				    )
				)
				
				VAR _PQ = IF (
				    [ShowValueForDates],
				    SUMX ( 
				        VALUES ( 'bc_date'[FW YearQuarterNumber] ),
				        VAR CurrentFiscalYearQuarterNumber = 'bc_date'[FW YearQuarterNumber]
				        VAR DaysSelected = 
				            CALCULATETABLE (
				                VALUES ( 'bc_date'[FW DayOfQuarterNumber] ),
				                REMOVEFILTERS (
				                    'bc_date'[IsWorkingDay],
				                    'bc_date'[Week Day],
				                    'bc_date'[WeekDayNumber]
				                ),
				                'bc_date'[DatesWithTransactions] = TRUE
				            )
				        RETURN 
				            CALCULATE (
				                SELECTEDMEASURE(),
				                'bc_date'[FW YearQuarterNumber] = CurrentFiscalYearQuarterNumber - 1,
				                DaysSelected,
				                ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] )
				            )
				    )
				)
				
				VAR _PY = IF (
				    [ShowValueForDates],
				    SUMX (
				        VALUES ( 'bc_date'[FW YearNumber] ),
				        VAR CurrentFiscalYearNumber = 'bc_date'[FW YearNumber]
				        VAR DaysSelected =
				            CALCULATETABLE (
				                VALUES ( 'bc_date'[FW DayOfYearNumber] ),
				                REMOVEFILTERS (
				                    'bc_date'[IsWorkingDay],
				                    'bc_date'[Week Day],
				                    'bc_date'[WeekDayNumber]
				                ),
				                'bc_date'[DatesWithTransactions] = TRUE
				            )
				        RETURN
				            CALCULATE (
				                SELECTEDMEASURE(),
				                'bc_date'[FW YearNumber] = CurrentFiscalYearNumber - 1,
				                DaysSelected,
				                ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] )
				            )
				    )
				)
				RETURN SWITCH ( 
				    TRUE,
				    ISINSCOPE ( 'bc_date'[FW Week Year] ), _PW,
				    -- The month level should not be managed in a 445 calendar
				    ISINSCOPE ( 'bc_date'[FW Quarter Year] ), _PQ,
				    ISINSCOPE ( 'bc_date'[FW Year] ), _PY
				)
				```

		calculationItem POP = ```
				VAR ValueCurrentPeriod = SELECTEDMEASURE()
				VAR WOWValuePreviousPeriod = IF (
				    [ShowValueForDates],
				    SUMX ( 
				        VALUES ( 'bc_date'[FW YearWeekNumber] ),
				        VAR CurrentFiscalYearWeekNumber = 'bc_date'[FW YearWeekNumber] 
				        VAR DaysSelected = 
				            CALCULATETABLE (
				                VALUES ( 'bc_date'[WeekDayNumber] ),
				                REMOVEFILTERS (
				                    'bc_date'[IsWorkingDay],
				                    'bc_date'[Week Day],
				                    'bc_date'[WeekDayNumber]
				                ),
				                'bc_date'[DatesWithTransactions] = TRUE
				            )
				        RETURN 
				            CALCULATE (
				                SELECTEDMEASURE(),
				                'bc_date'[FW YearWeekNumber] = CurrentFiscalYearWeekNumber - 1,
				                KEEPFILTERS ( DaysSelected ),
				                ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] )
				            )
				    )
				)
				VAR _WOW = IF (
				        NOT ISBLANK ( ValueCurrentPeriod ) 
				            && NOT ISBLANK ( WOWValuePreviousPeriod ),
				        ValueCurrentPeriod - WOWValuePreviousPeriod
				    )
				// ------------ QOQ
				VAR QOQValuePreviousPeriod = IF (
				    [ShowValueForDates],
				    SUMX ( 
				        VALUES ( 'bc_date'[FW YearQuarterNumber] ),
				        VAR CurrentFiscalYearQuarterNumber = 'bc_date'[FW YearQuarterNumber]
				        VAR DaysSelected = 
				            CALCULATETABLE (
				                VALUES ( 'bc_date'[FW DayOfQuarterNumber] ),
				                REMOVEFILTERS (
				                    'bc_date'[IsWorkingDay],
				                    'bc_date'[Week Day],
				                    'bc_date'[WeekDayNumber]
				                ),
				                'bc_date'[DatesWithTransactions] = TRUE
				            )
				        RETURN 
				            CALCULATE (
				                SELECTEDMEASURE(),
				                'bc_date'[FW YearQuarterNumber] = CurrentFiscalYearQuarterNumber - 1,
				                DaysSelected,
				                ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] )
				            )
				    )
				)
				VAR _QOQ = IF (
				        NOT ISBLANK ( ValueCurrentPeriod ) 
				            && NOT ISBLANK ( QOQValuePreviousPeriod ),
				        ValueCurrentPeriod - QOQValuePreviousPeriod
				    )
				//------------ YOY
				VAR YOYValuePreviousPeriod = IF (
				    [ShowValueForDates],
				    SUMX (
				        VALUES ( 'bc_date'[FW YearNumber] ),
				        VAR CurrentFiscalYearNumber = 'bc_date'[FW YearNumber]
				        VAR DaysSelected =
				            CALCULATETABLE (
				                VALUES ( 'bc_date'[FW DayOfYearNumber] ),
				                REMOVEFILTERS (
				                    'bc_date'[IsWorkingDay],
				                    'bc_date'[Week Day],
				                    'bc_date'[WeekDayNumber]
				                ),
				                'bc_date'[DatesWithTransactions] = TRUE
				            )
				        RETURN
				            CALCULATE (
				                SELECTEDMEASURE(),
				                'bc_date'[FW YearNumber] = CurrentFiscalYearNumber - 1,
				                DaysSelected,
				                ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] )
				            )
				    )
				)
				VAR _YOY = IF (
				        NOT ISBLANK ( ValueCurrentPeriod ) 
				            && NOT ISBLANK ( YOYValuePreviousPeriod ),
				        ValueCurrentPeriod - YOYValuePreviousPeriod
				    )
				
				RETURN SWITCH ( 
				    TRUE,
				    ISINSCOPE ( 'bc_date'[FW Week Year] ), _WOW,
				    -- The month level should not be managed in a 445 calendar
				    ISINSCOPE ( 'bc_date'[FW Quarter Year] ), _QOQ,
				    ISINSCOPE ( 'bc_date'[FW Year] ), _YOY
				)
				```

