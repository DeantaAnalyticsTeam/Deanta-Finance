		calculationItem 'YOY %' = ```
				VAR _PY = IF (
				    [ShowValueForDates],
				    SUMX (
				        VALUES ( 'bc_date'[FW YearNumber] ),
				        VAR CurrentFiscalYearNumber = 'bc_date'[FW YearNumber]
				        VAR DaysSelected =
				            CALCULATETABLE (
				                VALUES ( 'bc_date'[FW DayOfYearNumber] ),
				                REMOVEFILTERS (
				                    'bc_date'[IsWorkingDay],
				                    'bc_date'[Week Day],
				                    'bc_date'[WeekDayNumber]
				                ),
				                'bc_date'[DatesWithTransactions] = TRUE
				            )
				        RETURN
				            CALCULATE (
				                SELECTEDMEASURE(),
				                'bc_date'[FW YearNumber] = CurrentFiscalYearNumber - 1,
				                DaysSelected,
				                ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] )
				            )
				    )
				)
				VAR ValueCurrentPeriod = SELECTEDMEASURE()
				VAR ValuePreviousPeriod = IF (
				    [ShowValueForDates],
				    SUMX (
				        VALUES ( 'bc_date'[FW YearNumber] ),
				        VAR CurrentFiscalYearNumber = 'bc_date'[FW YearNumber]
				        VAR DaysSelected =
				            CALCULATETABLE (
				                VALUES ( 'bc_date'[FW DayOfYearNumber] ),
				                REMOVEFILTERS (
				                    'bc_date'[IsWorkingDay],
				                    'bc_date'[Week Day],
				                    'bc_date'[WeekDayNumber]
				                ),
				                'bc_date'[DatesWithTransactions] = TRUE
				            )
				        RETURN
				            CALCULATE (
				                SELECTEDMEASURE(),
				                'bc_date'[FW YearNumber] = CurrentFiscalYearNumber - 1,
				                DaysSelected,
				                ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] )
				            )
				    )
				)
				VAR _YOY = IF (
				        NOT ISBLANK ( ValueCurrentPeriod ) 
				            && NOT ISBLANK ( ValuePreviousPeriod ),
				        ValueCurrentPeriod - ValuePreviousPeriod
				    )
