				```

		calculationItem PYC = ```
				IF (
				    [ShowValueForDates] && HASONEVALUE ( 'bc_date'[FW YearNumber] ),
				    VAR PreviousFiscalYear = MAX ( 'bc_date'[FW YearNumber] ) - 1
				    VAR Result =
				        CALCULATE (
				            SELECTEDMEASURE(),
				            ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				            'bc_date'[FW YearNumber] = PreviousFiscalYear
				        )
				    RETURN
				        Result
				)
				
				```

		calculationItem YTDOPY = ```
				VAR ValueCurrentPeriod = IF ( 
				    [ShowValueForDates],
				    VAR LastDayAvailable = MAX ( 'bc_date'[FW DayOfYearNumber] )
				    VAR LastFiscalYearAvailable = MAX ( 'bc_date'[FW YearNumber] )
				    VAR Result =
				        CALCULATE (
				            SELECTEDMEASURE(),
				            ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				            'bc_date'[FW DayOfYearNumber] <= LastDayAvailable,
				            'bc_date'[FW YearNumber] = LastFiscalYearAvailable
				        )
				    RETURN
				        Result
				)
				VAR ValuePreviousPeriod = IF (
				    [ShowValueForDates] && HASONEVALUE ( 'bc_date'[FW YearNumber] ),
				    VAR PreviousFiscalYear = MAX ( 'bc_date'[FW YearNumber] ) - 1
				    VAR Result =
				        CALCULATE (
				            SELECTEDMEASURE(),
				            ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				            'bc_date'[FW YearNumber] = PreviousFiscalYear
				        )
				    RETURN
				        Result
				)
				RETURN IF (
				        NOT ISBLANK ( ValueCurrentPeriod ) 
				            && NOT ISBLANK ( ValuePreviousPeriod ),
				        ValueCurrentPeriod - ValuePreviousPeriod
				    )
				
