		calculationItem 'WTDOPW %' = ```
				VAR PWC = IF (
				    [ShowValueForDates] && HASONEVALUE ( 'bc_date'[FW YearWeekNumber] ),
				    VAR PreviousFiscalYearWeek = MAX ( 'bc_date'[FW YearWeekNumber] ) - 1
				    VAR Result =
				        CALCULATE (
				            SELECTEDMEASURE(),
				            ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				            'bc_date'[FW YearWeekNumber] = PreviousFiscalYearWeek
				        )
				    RETURN
				        Result
				)
				VAR ValueCurrentPeriod = IF ( 
				    [ShowValueForDates],
				    VAR LastDayOfWeekAvailable =  MAX ( 'bc_date'[WeekDayNumber] )
				    VAR LastFiscalYearWeekAvailable = MAX ( 'bc_date'[FW YearWeekNumber] )
				    VAR Result =
				        CALCULATE (
				            SELECTEDMEASURE(),
				            ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				            'bc_date'[WeekDayNumber] <= LastDayOfWeekAvailable,
				            'bc_date'[FW YearWeekNumber] = LastFiscalYearWeekAvailable
				        )
				    RETURN
				        Result
				)
				VAR ValuePreviousPeriod = IF (
				    [ShowValueForDates] && HASONEVALUE ( 'bc_date'[FW YearWeekNumber] ),
				    VAR PreviousFiscalYearWeek = MAX ( 'bc_date'[FW YearWeekNumber] ) - 1
				    VAR Result =
				        CALCULATE (
				            SELECTEDMEASURE(),
				            ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				            'bc_date'[FW YearWeekNumber] = PreviousFiscalYearWeek
				        )
				    RETURN
				        Result
				)
				VAR WTDOPW = IF (
				        NOT ISBLANK ( ValueCurrentPeriod ) 
				            && NOT ISBLANK ( ValuePreviousPeriod ),
				        ValueCurrentPeriod - ValuePreviousPeriod
				    )
				RETURN DIVIDE ( 
				    WTDOPW,
				    PWC
				)
				```

