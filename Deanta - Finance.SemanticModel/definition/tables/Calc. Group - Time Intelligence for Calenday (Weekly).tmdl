		calculationItem 'QOQ %' = ```
				VAR _PQ = IF (
				    [ShowValueForDates],
				    SUMX ( 
				        VALUES ( 'bc_date'[FW YearQuarterNumber] ),
				        VAR CurrentFiscalYearQuarterNumber = 'bc_date'[FW YearQuarterNumber]
				        VAR DaysSelected = 
				            CALCULATETABLE (
				                VALUES ( 'bc_date'[FW DayOfQuarterNumber] ),
				                REMOVEFILTERS (
				                    'bc_date'[IsWorkingDay],
				                    'bc_date'[Week Day],
				                    'bc_date'[WeekDayNumber]
				                ),
				                'bc_date'[DatesWithTransactions] = TRUE
				            )
				        RETURN 
				            CALCULATE (
				                SELECTEDMEASURE(),
				                'bc_date'[FW YearQuarterNumber] = CurrentFiscalYearQuarterNumber - 1,
				                DaysSelected,
				                ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] )
				            )
				    )
				)
				
				VAR ValueCurrentPeriod = SELECTEDMEASURE()
				VAR ValuePreviousPeriod = IF (
				    [ShowValueForDates],
				    SUMX ( 
				        VALUES ( 'bc_date'[FW YearQuarterNumber] ),
				        VAR CurrentFiscalYearQuarterNumber = 'bc_date'[FW YearQuarterNumber]
				        VAR DaysSelected = 
				            CALCULATETABLE (
				                VALUES ( 'bc_date'[FW DayOfQuarterNumber] ),
				                REMOVEFILTERS (
				                    'bc_date'[IsWorkingDay],
				                    'bc_date'[Week Day],
				                    'bc_date'[WeekDayNumber]
				                ),
				                'bc_date'[DatesWithTransactions] = TRUE
				            )
				        RETURN 
				            CALCULATE (
				                SELECTEDMEASURE(),
				                'bc_date'[FW YearQuarterNumber] = CurrentFiscalYearQuarterNumber - 1,
				                DaysSelected,
				                ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] )
				            )
				    )
				)
				VAR _QOQ = IF (
				        NOT ISBLANK ( ValueCurrentPeriod ) 
				            && NOT ISBLANK ( ValuePreviousPeriod ),
				        ValueCurrentPeriod - ValuePreviousPeriod
				    )
				
				RETURN DIVIDE ( 
				    _QOQ,
				    _PQ
				)
