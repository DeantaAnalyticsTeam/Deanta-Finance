				    VAR LastDayOfFiscalYearAvailable = 
				        CALCULATE ( 
				            MAX ( 'bc_date'[Fiscal DayOfYearNumber] ),
				            REMOVEFILTERS (                -- Remove filters from
				                'bc_date'[IsWorkingDay],       -- filter-safe columns
				                'bc_date'[Week Day],       -- to get the last day with data
				                'bc_date'[WeekDayNumber] -- selected in the report
				            ),
				            'bc_date'[DatesWithTransactions] = TRUE 
				        )
				    VAR Result =
				        CALCULATE (
				            SELECTEDMEASURE(),
				            ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				            'bc_date'[Fiscal YearNumber] = PreviousFiscalYear,
				            'bc_date'[Fiscal DayOfYearNumber] <= LastDayOfFiscalYearAvailable,
				            'bc_date'[DatesWithTransactions] = TRUE 
				        )
				    RETURN
				        Result
				)
				// -------- YOYTD
				
				VAR ValueCurrentPeriod = IF ( 
				    [ShowValueForDates],
				    VAR LastDayAvailable = MAX ( 'bc_date'[Fiscal DayOfYearNumber] )
				    VAR LastFiscalYearAvailable = MAX ( 'bc_date'[Fiscal YearNumber] )
				    VAR Result =
				        CALCULATE (
				            SELECTEDMEASURE(),
				            ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				            'bc_date'[Fiscal DayOfYearNumber] <= LastDayAvailable,
				            'bc_date'[Fiscal YearNumber] = LastFiscalYearAvailable
				        )
				    RETURN
				        Result
				)
				VAR ValuePreviousPeriod = IF ( 
				    [ShowValueForDates],
				    VAR PreviousFiscalYear = MAX ( 'bc_date'[Fiscal YearNumber] ) - 1
				    VAR LastDayOfFiscalYearAvailable = 
				        CALCULATE ( 
				            MAX ( 'bc_date'[Fiscal DayOfYearNumber] ),
				            REMOVEFILTERS (                -- Remove filters from
				                'bc_date'[IsWorkingDay],       -- filter-safe columns
				                'bc_date'[Week Day],       -- to get the last day with data
				                'bc_date'[WeekDayNumber] -- selected in the report
				            ),
				            'bc_date'[DatesWithTransactions] = TRUE 
				        )
				    VAR Result =
				        CALCULATE (
				            SELECTEDMEASURE(),
				            ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				            'bc_date'[Fiscal YearNumber] = PreviousFiscalYear,
				            'bc_date'[Fiscal DayOfYearNumber] <= LastDayOfFiscalYearAvailable,
				            'bc_date'[DatesWithTransactions] = TRUE 
				        )
				    RETURN
				        Result
				)
				VAR _YOYTD = IF (
				        NOT ISBLANK ( ValueCurrentPeriod ) 
				            && NOT ISBLANK ( ValuePreviousPeriod ),
				        ValueCurrentPeriod - ValuePreviousPeriod
				    )
				
				// -------- RETURN
				RETURN DIVIDE ( 
				    _YOYTD,
				    _PYTD
				)
				```

		calculationItem PM = ```
				VAR MonthsOffset = 1
				RETURN IF (
				    [ShowValueForDates],
				    SUMX (
				        SUMMARIZE ( 'bc_date', 'bc_date'[Fiscal YearMonthNumber] ),
				        VAR CurrentYearMonthNumber = 'bc_date'[Fiscal YearMonthNumber]
				        VAR PreviousYearMonthNumber = CurrentYearMonthNumber - MonthsOffset
				        VAR DaysOnMonth = 
				            CALCULATE (
				                COUNTROWS ( 'bc_date' ),
				                ALLEXCEPT ( 'bc_date', 'bc_date'[Fiscal YearMonthNumber], 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] )
				            )
				        VAR DaysSelected = 
				            CALCULATE ( 
				                COUNTROWS ( 'bc_date' ), 
				                'bc_date'[DatesWithTransactions] = TRUE 
				            )
				        RETURN IF (
				            DaysOnMonth = DaysSelected,
				
				            -- Selection of all days in the month
				            CALCULATE (
				                SELECTEDMEASURE(),
				                ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				                'bc_date'[Fiscal YearMonthNumber] = PreviousYearMonthNumber
				            ),
				            
				            -- Partial selection of days in a month
				            CALCULATE (
				                SELECTEDMEASURE(),
				                ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				                'bc_date'[Fiscal YearMonthNumber] = PreviousYearMonthNumber,
				                CALCULATETABLE ( 
				                    VALUES ( 'bc_date'[Fiscal DayOfMonthNumber] ),
				                    ALLEXCEPT ( 'bc_date', 'bc_date'[Fiscal DayOfMonthNumber], 'bc_date'[Date] ),
				                    'bc_date'[Fiscal YearMonthNumber] = CurrentYearMonthNumber,
				                    'bc_date'[DatesWithTransactions] = TRUE 
				                )
				            )
				        )
				    )
				)
				```

