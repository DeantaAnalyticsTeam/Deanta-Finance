		calculationItem PQTD = ```
				IF ( 
				    [ShowValueForDates],
				    VAR LastMonthSelected = 
				        MAX ( 'bc_date'[Fiscal YearMonthNumber] )
				    VAR DaysOnLastMonth = 
				        CALCULATE (
				            COUNTROWS ( 'bc_date' ),
				            ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				            'bc_date'[Fiscal YearMonthNumber] = LastMonthSelected
				        )
				    VAR DaysLastMonthSelected = 
				        CALCULATE ( 
				            COUNTROWS ( 'bc_date' ), 
				            'bc_date'[DatesWithTransactions] = TRUE,
				            'bc_date'[Fiscal YearMonthNumber] = LastMonthSelected
				        )
				    VAR LastDayOfMonthWithSales =  
				        MAX ( 
				            -- End of month of any month
				            31 * (DaysOnLastMonth = DaysLastMonthSelected),  
				            -- or last day selected with data 
				            CALCULATE ( 
				                MAX ( 'bc_date'[Fiscal DayOfMonthNumber] ),
				                REMOVEFILTERS (                -- Remove filters from all of the
				                    'bc_date'[IsWorkingDay],       -- filter-safe columns
				                    'bc_date'[Week Day],       -- to get the last day with data
				                    'bc_date'[WeekDayNumber] -- selected in the report
				                ),
				                'bc_date'[Fiscal YearMonthNumber] = LastMonthSelected,
				                'bc_date'[DatesWithTransactions] = TRUE 
				            )
				        )
				    VAR LastMonthInQuarterWithSales = 
				        CALCULATE ( 
				            MAX ( 'bc_date'[Fiscal MonthInQuarterNumber] ),
				            REMOVEFILTERS (                -- Remove filters from all of the
				                'bc_date'[IsWorkingDay],       -- filter-safe columns
				                'bc_date'[Week Day],       -- to get the last day with data
				                'bc_date'[WeekDayNumber] -- selected in the report
				            ),
				            'bc_date'[DatesWithTransactions] = TRUE 
				        )
				    VAR PreviousFiscalYearQuarter = 
				        MAX ( 'bc_date'[Fiscal YearQuarterNumber] ) - 1
				    VAR FilterQTD = 
				        FILTER (
				            ALL ( 'bc_date'[Fiscal MonthInQuarterNumber], 'bc_date'[Fiscal DayOfMonthNumber] ),
				            ISONORAFTER ( 
				                'bc_date'[Fiscal MonthInQuarterNumber], LastMonthInQuarterWithSales, DESC,
				                'bc_date'[Fiscal DayOfMonthNumber], LastDayOfMonthWithSales, DESC
				            )
				        )
				    VAR Result =
				        CALCULATE (
				            SELECTEDMEASURE(),
				            ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				            'bc_date'[Fiscal YearQuarterNumber] = PreviousFiscalYearQuarter,
				            FilterQTD
				        )
				    RETURN
				        Result
				)
				```

