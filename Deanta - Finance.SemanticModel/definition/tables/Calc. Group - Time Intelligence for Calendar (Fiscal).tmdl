		calculationItem 'MTDOPM %' = ```
				VAR MTDOPMValueCurrentPeriod = IF ( 
				    [ShowValueForDates],
				    VAR LastDayAvailable =  MAX ( 'bc_date'[Fiscal DayOfMonthNumber] )
				    VAR LastFiscalYearMonthAvailable = MAX ( 'bc_date'[Fiscal YearMonthNumber] )
				    VAR Result =
				        CALCULATE (
				            SELECTEDMEASURE(),
				            ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				            'bc_date'[Fiscal DayOfMonthNumber] <= LastDayAvailable,
				            'bc_date'[Fiscal YearMonthNumber] = LastFiscalYearMonthAvailable
				        )
				    RETURN
				        Result
				)
				VAR MTDOPMValuePreviousPeriod = IF (
				    [ShowValueForDates] && HASONEVALUE ( 'bc_date'[Fiscal YearMonthNumber] ),
				    VAR PreviousFiscalYearMonth = MAX ( 'bc_date'[Fiscal YearMonthNumber] ) - 1
				    VAR Result =
				        CALCULATE (
				            SELECTEDMEASURE(),
				            ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				            'bc_date'[Fiscal YearMonthNumber] = PreviousFiscalYearMonth
				        )
				    RETURN
				        Result
				)
				
				//------- MTDOPM
				VAR _MTDOPM = IF (
				        NOT ISBLANK ( MTDOPMValueCurrentPeriod ) 
				            && NOT ISBLANK ( MTDOPMValuePreviousPeriod ),
				        MTDOPMValueCurrentPeriod - MTDOPMValuePreviousPeriod
				    )
				//------- PMC
				VAR _PMC = IF (
				    [ShowValueForDates] && HASONEVALUE ( 'bc_date'[Fiscal YearMonthNumber] ),
				    VAR PreviousFiscalYearMonth = MAX ( 'bc_date'[Fiscal YearMonthNumber] ) - 1
				    VAR Result =
				        CALCULATE (
				            SELECTEDMEASURE(),
				            ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				            'bc_date'[Fiscal YearMonthNumber] = PreviousFiscalYearMonth
				        )
				    RETURN
				        Result
				)
				
				//------- RETURN
				RETURN DIVIDE ( 
				    _MTDOPM,
				    _PMC
				) 
