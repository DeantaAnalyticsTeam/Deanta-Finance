table 'Calc. Group - Time Intelligence for Calendar (Fiscal)'
	lineageTag: 7f8c5169-0731-42f6-adcc-66724a6e0bce

	calculationGroup
		precedence: 3

		calculationItem MTD = ```
				IF ( 
				    [ShowValueForDates],
				    VAR LastDayAvailable =  MAX ( 'bc_date'[Fiscal DayOfMonthNumber] )
				    VAR LastFiscalYearMonthAvailable = MAX ( 'bc_date'[Fiscal YearMonthNumber] )
				    VAR Result =
				        CALCULATE (
				            SELECTEDMEASURE(),
				            ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				            'bc_date'[Fiscal DayOfMonthNumber] <= LastDayAvailable,
				            'bc_date'[Fiscal YearMonthNumber] = LastFiscalYearMonthAvailable
				        )
				    RETURN
				        Result
				)
				```

		calculationItem POP = ```
				VAR ValueCurrentPeriod = SELECTEDMEASURE()
				VAR MOMMonthsOffset = 1
				VAR MOMValuePreviousPeriod = IF (
				    [ShowValueForDates],
				    SUMX (
				        SUMMARIZE ( 'bc_date', 'bc_date'[Fiscal YearMonthNumber] ),
				        VAR CurrentYearMonthNumber = 'bc_date'[Fiscal YearMonthNumber]
				        VAR PreviousYearMonthNumber = CurrentYearMonthNumber - MOMMonthsOffset
				        VAR DaysOnMonth = 
				            CALCULATE (
				                COUNTROWS ( 'bc_date' ),
				                ALLEXCEPT ( 'bc_date', 'bc_date'[Fiscal YearMonthNumber], 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] )
				            )
				        VAR DaysSelected = 
				            CALCULATE ( 
				                COUNTROWS ( 'bc_date' ), 
				                'bc_date'[DatesWithTransactions] = TRUE 
				            )
				        RETURN IF (
				            DaysOnMonth = DaysSelected,
				
				            -- Selection of all days in the month
				            CALCULATE (
				                SELECTEDMEASURE(),
				                ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				                'bc_date'[Fiscal YearMonthNumber] = PreviousYearMonthNumber
				            ),
				            
				            -- Partial selection of days in a month
				            CALCULATE (
				                SELECTEDMEASURE(),
				                ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				                'bc_date'[Fiscal YearMonthNumber] = PreviousYearMonthNumber,
				                CALCULATETABLE ( 
				                    VALUES ( 'bc_date'[Fiscal DayOfMonthNumber] ),
				                    ALLEXCEPT ( 'bc_date', 'bc_date'[Fiscal DayOfMonthNumber], 'bc_date'[Date] ),
				                    'bc_date'[Fiscal YearMonthNumber] = CurrentYearMonthNumber,
				                    'bc_date'[DatesWithTransactions] = TRUE 
				                )
				            )
				        )
				    )
				)
				VAR _MOM = IF (
				        NOT ISBLANK ( ValueCurrentPeriod ) 
				            && NOT ISBLANK ( MOMValuePreviousPeriod ),
				        ValueCurrentPeriod - MOMValuePreviousPeriod
				    )
				// --------- QOQ 
				
				VAR QOQMonthsOffset = 3
				VAR QOQValuePreviousPeriod = IF (
				    [ShowValueForDates],
				    SUMX (
				        SUMMARIZE ( 'bc_date', 'bc_date'[Fiscal YearMonthNumber] ),
				        VAR CurrentYearMonthNumber = 'bc_date'[Fiscal YearMonthNumber]
				        VAR PreviousYearMonthNumber = CurrentYearMonthNumber - QOQMonthsOffset
				        VAR DaysOnMonth = 
				            CALCULATE (
				                COUNTROWS ( 'bc_date' ),
				                ALLEXCEPT ( 'bc_date', 'bc_date'[Fiscal YearMonthNumber], 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] )
				            )
				        VAR DaysSelected = 
				            CALCULATE ( 
				                COUNTROWS ( 'bc_date' ), 
				                'bc_date'[DatesWithTransactions] = TRUE 
				            )
				        RETURN IF (
				            DaysOnMonth = DaysSelected,
				
				            -- Selection of all days in the month
				            CALCULATE (
				                SELECTEDMEASURE(),
				                ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				                'bc_date'[Fiscal YearMonthNumber] = PreviousYearMonthNumber
				            ),
				            
				            -- Partial selection of days in a month
				            CALCULATE (
				                SELECTEDMEASURE(),
				                ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				                'bc_date'[Fiscal YearMonthNumber] = PreviousYearMonthNumber,
				                CALCULATETABLE ( 
				                    VALUES ( 'bc_date'[Fiscal DayOfMonthNumber] ),
				                    ALLEXCEPT ( 'bc_date', 'bc_date'[Fiscal DayOfMonthNumber], 'bc_date'[Date] ),
				                    'bc_date'[Fiscal YearMonthNumber] = CurrentYearMonthNumber,
				                    'bc_date'[DatesWithTransactions] = TRUE 
				                )
				            )
				        )
				    )
				)
				VAR _QOQ = IF (
				        NOT ISBLANK ( ValueCurrentPeriod ) 
				            && NOT ISBLANK ( QOQValuePreviousPeriod ),
				        ValueCurrentPeriod - QOQValuePreviousPeriod
				    )
				// --------- YOY
				VAR YOYMonthsOffset = 12
				VAR YOYValuePreviousPeriod = IF (
				    [ShowValueForDates],
				    SUMX (
				        SUMMARIZE ( 'bc_date', 'bc_date'[Fiscal YearMonthNumber] ),
				        VAR CurrentYearMonthNumber = 'bc_date'[Fiscal YearMonthNumber]
				        VAR PreviousYearMonthNumber = CurrentYearMonthNumber - YOYMonthsOffset
				        VAR DaysOnMonth = 
				            CALCULATE (
				                COUNTROWS ( 'bc_date' ),
				                ALLEXCEPT ( 
				                    'bc_date', 
				                    'bc_date'[Fiscal YearMonthNumber],  -- Year Month granularity
				                    'bc_date'[IsWorkingDay],        -- Filter-safe Date column
				                    'bc_date'[Week Day]         -- Filter-safe Date column
				                )
				            )
				        VAR DaysSelected = 
				            CALCULATE ( 
				                COUNTROWS ( 'bc_date' ), 
				                'bc_date'[DatesWithTransactions] = TRUE 
				            )
				        RETURN IF (
				            DaysOnMonth = DaysSelected,
				
				            -- Selection of all days in the month
				            CALCULATE (
				                SELECTEDMEASURE(),
				                ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				                'bc_date'[Fiscal YearMonthNumber] = PreviousYearMonthNumber
				            ),
				            
				            -- Partial selection of days in a month
				            CALCULATE (
				                SELECTEDMEASURE(),
				                ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				                'bc_date'[Fiscal YearMonthNumber] = PreviousYearMonthNumber,
				                CALCULATETABLE ( 
				                    VALUES ( 'bc_date'[Fiscal DayOfMonthNumber] ),
				                    ALLEXCEPT ( 'bc_date', 'bc_date'[Fiscal DayOfMonthNumber], 'bc_date'[Date] ),
				                    'bc_date'[Fiscal YearMonthNumber] = CurrentYearMonthNumber,
				                    'bc_date'[DatesWithTransactions] = TRUE 
				                )
				            )
				        )
				    )
				)
				VAR _YOY = IF (
				        NOT ISBLANK ( ValueCurrentPeriod ) 
				            && NOT ISBLANK ( YOYValuePreviousPeriod ),
				        ValueCurrentPeriod - YOYValuePreviousPeriod
				    )
				
				
				// --------- RETURN 
				RETURN SWITCH ( 
				    TRUE,
				    ISINSCOPE ( 'bc_date'[Fiscal Month Year] ), _MOM,
				    ISINSCOPE ( 'bc_date'[Fiscal Quarter Year] ), _QOQ,
				    ISINSCOPE ( 'bc_date'[Fiscal Year] ), _YOY
				)
				
				```

		calculationItem 'POP %' = ```
				VAR ValueCurrentPeriod = SELECTEDMEASURE()
				//--------- MOM
				VAR MOMMonthsOffset = 1
				VAR _PM = IF (
				    [ShowValueForDates],
				    SUMX (
				        SUMMARIZE ( 'bc_date', 'bc_date'[Fiscal YearMonthNumber] ),
				        VAR CurrentYearMonthNumber = 'bc_date'[Fiscal YearMonthNumber]
				        VAR PreviousYearMonthNumber = CurrentYearMonthNumber - MOMMonthsOffset
				        VAR DaysOnMonth = 
				            CALCULATE (
				                COUNTROWS ( 'bc_date' ),
				                ALLEXCEPT ( 'bc_date', 'bc_date'[Fiscal YearMonthNumber], 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] )
				            )
				        VAR DaysSelected = 
				            CALCULATE ( 
				                COUNTROWS ( 'bc_date' ), 
				                'bc_date'[DatesWithTransactions] = TRUE 
				            )
				        RETURN IF (
				            DaysOnMonth = DaysSelected,
				
				            -- Selection of all days in the month
				            CALCULATE (
				                SELECTEDMEASURE(),
				                ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				                'bc_date'[Fiscal YearMonthNumber] = PreviousYearMonthNumber
				            ),
				            
				            -- Partial selection of days in a month
				            CALCULATE (
				                SELECTEDMEASURE(),
				                ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				                'bc_date'[Fiscal YearMonthNumber] = PreviousYearMonthNumber,
				                CALCULATETABLE ( 
				                    VALUES ( 'bc_date'[Fiscal DayOfMonthNumber] ),
				                    ALLEXCEPT ( 'bc_date', 'bc_date'[Fiscal DayOfMonthNumber], 'bc_date'[Date] ),
				                    'bc_date'[Fiscal YearMonthNumber] = CurrentYearMonthNumber,
				                    'bc_date'[DatesWithTransactions] = TRUE 
				                )
				            )
				        )
				    )
				)
				VAR _MOM = IF (
				        NOT ISBLANK ( ValueCurrentPeriod ) 
				            && NOT ISBLANK ( _PM ),
				        ValueCurrentPeriod - _PM
				    )
				VAR _MOM_PERCENTAGE = DIVIDE ( 
				    _MOM,
				    _PM
				)
				//-------- QOQ
				VAR QOQMonthsOffset = 3
				VAR QOQValuePreviousPeriod = IF (
				    [ShowValueForDates],
				    SUMX (
				        SUMMARIZE ( 'bc_date', 'bc_date'[Fiscal YearMonthNumber] ),
				        VAR CurrentYearMonthNumber = 'bc_date'[Fiscal YearMonthNumber]
				        VAR PreviousYearMonthNumber = CurrentYearMonthNumber - QOQMonthsOffset
				        VAR DaysOnMonth = 
				            CALCULATE (
				                COUNTROWS ( 'bc_date' ),
				                ALLEXCEPT ( 'bc_date', 'bc_date'[Fiscal YearMonthNumber], 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] )
				            )
				        VAR DaysSelected = 
				            CALCULATE ( 
				                COUNTROWS ( 'bc_date' ), 
				                'bc_date'[DatesWithTransactions] = TRUE 
				            )
				        RETURN IF (
				            DaysOnMonth = DaysSelected,
				
				            -- Selection of all days in the month
				            CALCULATE (
				                SELECTEDMEASURE(),
				                ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				                'bc_date'[Fiscal YearMonthNumber] = PreviousYearMonthNumber
				            ),
				            
				            -- Partial selection of days in a month
				            CALCULATE (
				                SELECTEDMEASURE(),
				                ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				                'bc_date'[Fiscal YearMonthNumber] = PreviousYearMonthNumber,
				                CALCULATETABLE ( 
				                    VALUES ( 'bc_date'[Fiscal DayOfMonthNumber] ),
				                    ALLEXCEPT ( 'bc_date', 'bc_date'[Fiscal DayOfMonthNumber], 'bc_date'[Date] ),
				                    'bc_date'[Fiscal YearMonthNumber] = CurrentYearMonthNumber,
				                    'bc_date'[DatesWithTransactions] = TRUE 
				                )
				            )
				        )
				    )
				)
				VAR QOQ_PERCENTAGE = IF (
				        NOT ISBLANK ( ValueCurrentPeriod ) 
				            && NOT ISBLANK ( QOQValuePreviousPeriod ),
				        ValueCurrentPeriod - QOQValuePreviousPeriod
				    )
				//-------- YOY
				VAR YOYMonthsOffset = 12
				VAR _PY = IF (
				    [ShowValueForDates],
				    SUMX (
				        SUMMARIZE ( 'bc_date', 'bc_date'[Fiscal YearMonthNumber] ),
				        VAR CurrentYearMonthNumber = 'bc_date'[Fiscal YearMonthNumber]
				        VAR PreviousYearMonthNumber = CurrentYearMonthNumber - YOYMonthsOffset
				        VAR DaysOnMonth = 
				            CALCULATE (
				                COUNTROWS ( 'bc_date' ),
				                ALLEXCEPT ( 
				                    'bc_date', 
				                    'bc_date'[Fiscal YearMonthNumber],  -- Year Month granularity
				                    'bc_date'[IsWorkingDay],        -- Filter-safe Date column
				                    'bc_date'[Week Day]         -- Filter-safe Date column
				                )
				            )
				        VAR DaysSelected = 
				            CALCULATE ( 
				                COUNTROWS ( 'bc_date' ), 
				                'bc_date'[DatesWithTransactions] = TRUE 
				            )
				        RETURN IF (
				            DaysOnMonth = DaysSelected,
				
				            -- Selection of all days in the month
				            CALCULATE (
				                SELECTEDMEASURE(),
				                ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				                'bc_date'[Fiscal YearMonthNumber] = PreviousYearMonthNumber
				            ),
				            
				            -- Partial selection of days in a month
				            CALCULATE (
				                SELECTEDMEASURE(),
				                ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				                'bc_date'[Fiscal YearMonthNumber] = PreviousYearMonthNumber,
				                CALCULATETABLE ( 
				                    VALUES ( 'bc_date'[Fiscal DayOfMonthNumber] ),
				                    ALLEXCEPT ( 'bc_date', 'bc_date'[Fiscal DayOfMonthNumber], 'bc_date'[Date] ),
				                    'bc_date'[Fiscal YearMonthNumber] = CurrentYearMonthNumber,
				                    'bc_date'[DatesWithTransactions] = TRUE 
				                )
				            )
				        )
				    )
				)
				
				VAR YOYValuePreviousPeriod = IF (
				    [ShowValueForDates],
				    SUMX (
				        SUMMARIZE ( 'bc_date', 'bc_date'[Fiscal YearMonthNumber] ),
				        VAR CurrentYearMonthNumber = 'bc_date'[Fiscal YearMonthNumber]
				        VAR PreviousYearMonthNumber = CurrentYearMonthNumber - YOYMonthsOffset
				        VAR DaysOnMonth = 
				            CALCULATE (
				                COUNTROWS ( 'bc_date' ),
				                ALLEXCEPT ( 
				                    'bc_date', 
				                    'bc_date'[Fiscal YearMonthNumber],  -- Year Month granularity
				                    'bc_date'[IsWorkingDay],        -- Filter-safe Date column
				                    'bc_date'[Week Day]         -- Filter-safe Date column
				                )
				            )
				        VAR DaysSelected = 
				            CALCULATE ( 
				                COUNTROWS ( 'bc_date' ), 
				                'bc_date'[DatesWithTransactions] = TRUE 
				            )
				        RETURN IF (
				            DaysOnMonth = DaysSelected,
				
				            -- Selection of all days in the month
				            CALCULATE (
				                SELECTEDMEASURE(),
				                ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				                'bc_date'[Fiscal YearMonthNumber] = PreviousYearMonthNumber
				            ),
				            
				            -- Partial selection of days in a month
				            CALCULATE (
				                SELECTEDMEASURE(),
				                ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				                'bc_date'[Fiscal YearMonthNumber] = PreviousYearMonthNumber,
				                CALCULATETABLE ( 
				                    VALUES ( 'bc_date'[Fiscal DayOfMonthNumber] ),
				                    ALLEXCEPT ( 'bc_date', 'bc_date'[Fiscal DayOfMonthNumber], 'bc_date'[Date] ),
				                    'bc_date'[Fiscal YearMonthNumber] = CurrentYearMonthNumber,
				                    'bc_date'[DatesWithTransactions] = TRUE 
				                )
				            )
				        )
				    )
				)
				VAR _YOY = IF (
				        NOT ISBLANK ( ValueCurrentPeriod ) 
				            && NOT ISBLANK ( YOYValuePreviousPeriod ),
				        ValueCurrentPeriod - YOYValuePreviousPeriod
				    )
				
				
				VAR YOY_PERCENTANGE = DIVIDE ( 
				    _YOY,
				    _PY
				)
				
				//--------- RETURN
				RETURN SWITCH ( 
				    TRUE,
				    ISINSCOPE ( 'bc_date'[Fiscal Month Year] ), _MOM_PERCENTAGE,
				    ISINSCOPE ( 'bc_date'[Fiscal Quarter Year] ), QOQ_PERCENTAGE,
				    ISINSCOPE ( 'bc_date'[Fiscal Year] ), YOY_PERCENTANGE
				)
				```

		calculationItem PMC =
				IF (
				    [ShowValueForDates] && HASONEVALUE ( 'bc_date'[Fiscal YearMonthNumber] ),
				    VAR PreviousFiscalYearMonth = MAX ( 'bc_date'[Fiscal YearMonthNumber] ) - 1
				    VAR Result =
				        CALCULATE (
				            SELECTEDMEASURE(),
				            ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				            'bc_date'[Fiscal YearMonthNumber] = PreviousFiscalYearMonth
				        )
				    RETURN
				        Result
				)

		calculationItem MTDOPM = ```
				VAR ValueCurrentPeriod = IF ( 
				    [ShowValueForDates],
				    VAR LastDayAvailable =  MAX ( 'bc_date'[Fiscal DayOfMonthNumber] )
				    VAR LastFiscalYearMonthAvailable = MAX ( 'bc_date'[Fiscal YearMonthNumber] )
				    VAR Result =
				        CALCULATE (
