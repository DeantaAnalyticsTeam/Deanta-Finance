				            CALCULATE (
				                SELECTEDMEASURE(),
				                ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				                'bc_date'[Fiscal YearMonthNumber] = PreviousYearMonthNumber
				            ),
				            
				            -- Partial selection of days in a month
				            CALCULATE (
				                SELECTEDMEASURE(),
				                ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				                'bc_date'[Fiscal YearMonthNumber] = PreviousYearMonthNumber,
				                CALCULATETABLE ( 
				                    VALUES ( 'bc_date'[Fiscal DayOfMonthNumber] ),
				                    ALLEXCEPT ( 'bc_date', 'bc_date'[Fiscal DayOfMonthNumber], 'bc_date'[Date] ),
				                    'bc_date'[Fiscal YearMonthNumber] = CurrentYearMonthNumber,
				                    'bc_date'[DatesWithTransactions] = TRUE 
				                )
				            )
				        )
				    )
				)
				// ---------- PY
				VAR PYMonthsOffset = 12
				VAR _PY = IF (
				    [ShowValueForDates],
				    SUMX (
				        SUMMARIZE ( 'bc_date', 'bc_date'[Fiscal YearMonthNumber] ),
				        VAR CurrentYearMonthNumber = 'bc_date'[Fiscal YearMonthNumber]
				        VAR PreviousYearMonthNumber = CurrentYearMonthNumber - PYMonthsOffset
				        VAR DaysOnMonth = 
				            CALCULATE (
				                COUNTROWS ( 'bc_date' ),
				                ALLEXCEPT ( 
				                    'bc_date', 
				                    'bc_date'[Fiscal YearMonthNumber],  -- Year Month granularity
				                    'bc_date'[IsWorkingDay],        -- Filter-safe Date column
				                    'bc_date'[Week Day]         -- Filter-safe Date column
				                )
				            )
				        VAR DaysSelected = 
				            CALCULATE ( 
				                COUNTROWS ( 'bc_date' ), 
				                'bc_date'[DatesWithTransactions] = TRUE 
				            )
				        RETURN IF (
				            DaysOnMonth = DaysSelected,
				
				            -- Selection of all days in the month
				            CALCULATE (
				                SELECTEDMEASURE(),
				                ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				                'bc_date'[Fiscal YearMonthNumber] = PreviousYearMonthNumber
				            ),
				            
				            -- Partial selection of days in a month
				            CALCULATE (
				                SELECTEDMEASURE(),
				                ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				                'bc_date'[Fiscal YearMonthNumber] = PreviousYearMonthNumber,
				                CALCULATETABLE ( 
				                    VALUES ( 'bc_date'[Fiscal DayOfMonthNumber] ),
				                    ALLEXCEPT ( 'bc_date', 'bc_date'[Fiscal DayOfMonthNumber], 'bc_date'[Date] ),
				                    'bc_date'[Fiscal YearMonthNumber] = CurrentYearMonthNumber,
				                    'bc_date'[DatesWithTransactions] = TRUE 
				                )
				            )
				        )
				    )
				)
				// ---------- RETURN
				RETURN SWITCH ( 
				    TRUE,
				    ISINSCOPE ( 'bc_date'[Fiscal Month Year] ), _PM,
				    ISINSCOPE ( 'bc_date'[Fiscal Quarter Year] ), _PQ,
				    ISINSCOPE ( 'bc_date'[Fiscal Year] ), _PY
				)
				```

		calculationItem 'QTDOPQ %' = ```
				//--------- QTDOPQ
				VAR ValueCurrentPeriod = IF ( 
				    [ShowValueForDates],
				    VAR LastDayAvailable =  MAX ( 'bc_date'[Fiscal DayOfYearNumber] )
				    VAR LastFiscalYearQuarterAvailable = MAX ( 'bc_date'[Fiscal YearQuarterNumber] )
				    VAR Result =
				        CALCULATE (
				            SELECTEDMEASURE(),
				            ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				            'bc_date'[Fiscal DayOfYearNumber] <= LastDayAvailable,
				            'bc_date'[Fiscal YearQuarterNumber] = LastFiscalYearQuarterAvailable
				        )
				    RETURN
				        Result
				)
				VAR ValuePreviousPeriod = IF (
				    [ShowValueForDates] && HASONEVALUE ( 'bc_date'[Fiscal YearQuarterNumber] ),
				    VAR PreviousFiscalYearQuarter = MAX ( 'bc_date'[Fiscal YearQuarterNumber] ) - 1
				    VAR Result =
				        CALCULATE (
				            SELECTEDMEASURE(),
				            ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				            'bc_date'[Fiscal YearQuarterNumber] = PreviousFiscalYearQuarter
				        )
				    RETURN
				        Result
				)
				VAR _QTDOPQ = IF (
				        NOT ISBLANK ( ValueCurrentPeriod ) 
				            && NOT ISBLANK ( ValuePreviousPeriod ),
				        ValueCurrentPeriod - ValuePreviousPeriod
				    )
				//--------- PQC
				VAR _PQC = IF (
				    [ShowValueForDates] && HASONEVALUE ( 'bc_date'[Fiscal YearQuarterNumber] ),
				    VAR PreviousFiscalYearQuarter = MAX ( 'bc_date'[Fiscal YearQuarterNumber] ) - 1
				    VAR Result =
				        CALCULATE (
				            SELECTEDMEASURE(),
				            ALLEXCEPT ( 'bc_date', 'bc_date'[IsWorkingDay], 'bc_date'[Week Day] ),
				            'bc_date'[Fiscal YearQuarterNumber] = PreviousFiscalYearQuarter
				        )
				    RETURN
				        Result
				)
				//--------- RETURN
				RETURN DIVIDE ( 
				    _QTDOPQ,
				    _PQC
				)
				```

