				            'bc_date'[Fiscal DayOfMonthNumber] <= LastDayAvailable,
				            'bc_date'[Fiscal YearMonthNumber] = LastFiscalYearMonthAvailable
				        )
				    RETURN
				        Result
				)
				VAR ValuePreviousPeriod = IF ( 
				    [ShowValueForDates],
				    VAR LastMonthSelected = 
				        MAX ( 'bc_date'[Fiscal YearMonthNumber] )
				    VAR DaysOnLastMonth = 
				        CALCULATE (
