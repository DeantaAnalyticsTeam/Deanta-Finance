		calculationItem 'AVG 1Y' =
				IF (
				    [ShowValueForDates],
				    VAR LastDayMAT =
				        MAX ( 'bc_date'[Sequential365DayNumber] )
				    VAR FirstDayMAT =
				        INT ( EDATE ( LastDayMAT + 1, -12 ) )
				    VAR Period1Y =
				        CALCULATETABLE (
				            VALUES ( 'bc_date'[Sequential365DayNumber] ),
				            ALLEXCEPT (
				                'bc_date',
				                'bc_date'[IsWorkingDay],
				                'bc_date'[Week Day]
				            ),
				            'bc_date'[Sequential365DayNumber] >= FirstDayMAT
				                && 'bc_date'[Sequential365DayNumber] <= LastDayMAT,
				            'bc_date'[DatesWithTransactions] = TRUE
				        )
				    VAR FirstDayWithData =
				        CALCULATE (
				            INT ( MIN ( 'bc_g/l_entries'[Posting Date] ) ),
				            REMOVEFILTERS ()
				        )
				    VAR FirstDayInPeriod =
				        MINX (
				            Period1Y,
				            'bc_date'[Sequential365DayNumber]
				        )
				    VAR Result =
				        IF (
				            FirstDayWithData <= FirstDayInPeriod,
				            CALCULATE (
				                AVERAGEX ( Period1Y, SELECTEDMEASURE() ),
				                REMOVEFILTERS ( 'bc_date' )
				            )
				        )
				    RETURN
				        Result
				)

